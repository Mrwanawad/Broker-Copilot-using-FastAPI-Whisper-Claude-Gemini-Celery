# Anthropic credentials: ANTHROPIC_API_KEY (or an `ant auth login` profile)
ANTHROPIC_API_KEY=
BC_CLAUDE_MODEL=claude-opus-5-5
BC_CLAUDE_EFFORT=medium
# Gemini fallback (Google AI Studio key)
GOOGLE_API_KEY=
BC_GEMINI_MODEL=gemini-3.5-flash
# auto = Claude when credentials exist, else Gemini when GOOGLE_API_KEY is set, else the offline rules
# extractor. An LLM error falls through the same chain. Other values: claude | gemini | rules
BC_SUMMARIZER=auto

# ASR: faster_whisper (local CPU) | openai (Whisper API) | none (text-only)
BC_ASR_BACKEND=faster_whisper
BC_WHISPER_MODEL=small
OPENAI_API_KEY=

# Diarization: pyannote (needs HF_TOKEN + accepted model terms) | heuristic
BC_DIARIZER=heuristic
HF_TOKEN=

# Uploads: local (BC_UPLOAD_DIR) | s3 (AWS S3 / Cloudflare R2 / MinIO; credentials via AWS_* env)
BC_STORAGE_BACKEND=local
BC_S3_BUCKET=
BC_S3_ENDPOINT_URL=

# Postgres in docker/render; SQLite locally
BC_DATABASE_URL=sqlite:///./data/broker_copilot.db
# Empty = run jobs inline (no Redis needed)
BC_REDIS_URL=

BC_CRM_CONFIDENCE_THRESHOLD=0.75
BC_CRM_BACKEND=local
BC_CRM_API_URL=
BC_CRM_API_TOKEN=

BC_WHATSAPP_VERIFY_TOKEN=change-me
BC_WHATSAPP_ACCESS_TOKEN=
BC_TWILIO_AUTH_TOKEN=
BC_API_KEYS=dev:dev-key
